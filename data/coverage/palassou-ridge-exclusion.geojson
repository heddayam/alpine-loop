    "policySourceUrls": [
      "https://www.openspaceauthority.org/land-protection",
      "https://files.santaclaracounty.gov/exjcpb1516/2025-04/easy-trails-coyote-lake-harvey-bear-ranch.pdf"
    ],
    "policyBasis": "Preserve the explicit Henry Coe charter exclusion. The county Coyote Lake guide map labels Palassou Open Space No Public Access; pinned OSM additionally tags access=no and hiking=no. Occasional authorized programs are not general hiking access. This exclusion applies only to the newly reachable buffer outside the prior Henry Coe footprint; source way-level restrictions continue to apply within that footprint.",
    "priorDecision": "data/regions/henry-coe/charter.md: explicit exclusions",
    "attribution": "© OpenStreetMap contributors; Open Database License (ODbL) 1.0",
    "derivation": "Product exclusion = exact pinned OSM polygon minus the existing reviewed Henry Coe start footprint, using polygon-clipping difference without padding or simplification. Original mapped polygon geometry hash uses SHA-256 of JSON.stringify(geometry). The subtraction preserves previously reviewed park/entrance coverage rather than treating overlapping mapped boundaries as a legal determination.",
    "sourceTags": {
      "access": "no",
      "bicycle": "no",
      "boundary": "protected_area",
      "dog": "no",
      "hiking": "no",
      "horse": "no",
      "leisure": "nature_reserve",
      "name": "Palassou Ridge Preserve",
      "operator": "Santa Clara Valley Open Space Authority",
      "protect_class": "4",
      "protected_area": "nature_reserve",
      "protection_title": "Habitat/Wildlife Reserve",
      "website": "https://www.openspaceauthority.org/"
    },
    "limitation": "Preserves the previous product exclusion against newly extended route buffers. It is not a current cadastral boundary or a grant of access to the preserved footprint. The mapped reserve overlaps previously reviewed Coe land; the CDFW management plan records land transferred for a State Parks entrance, so raw OSM overlap is not used to remove established park coverage.",
    "sourceGeometrySha256": "6a369a3d7ccfe9441761bf993a35611606dcee0a195106d0528b074035831ad3",
