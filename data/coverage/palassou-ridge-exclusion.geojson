    "id": "palassou-ridge",
    "name": "Palassou Ridge Preserve — outside reviewed Henry Coe footprint",
    "authority": "Alpine Loop retained coverage policy; mapped extent from OpenStreetMap contributors",
    "sourceUrl": "https://download.geofabrik.de/north-america/us/california/norcal-260801.osm.pbf",
    "sourceSha256": "215f18449e6cd190200a7dc1188a63dba2bec1f20fb3d1637c4f11c1f9134342",
