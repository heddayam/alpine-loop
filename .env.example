# Server-only ArcGIS credentials. Prefer separate least-privilege keys.
# ARCGIS_API_KEY=
ARCGIS_GEOCODING_API_KEY=
ARCGIS_ROUTING_API_KEY=

# Optional ignored runtime location for aggregate monthly counters only.
# ALPINE_PROVIDER_USAGE_DB=.local-data/runtime/provider-usage.sqlite
# ALPINE_ROUTE_JOBS_DB=.local-data/runtime/route-jobs.sqlite
# Optional full-catalog override. Leave unset to use `.local-data/packs`.
# Every pack expected in the app must be installed beneath the override root.
# ALPINE_PACK_ROOT=/absolute/path/to/another-complete-pack-catalog
