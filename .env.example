# Server-only ArcGIS credentials. Prefer separate least-privilege keys.
# ARCGIS_API_KEY=
ARCGIS_GEOCODING_API_KEY=
ARCGIS_ROUTING_API_KEY=

# Optional Docker host binding. Defaults keep the app local to this computer.
# ALPINE_BIND_ADDRESS=127.0.0.1
# ALPINE_PORT=3000

# Solver processes per search, 1–8; default is up to 2 available CPUs.
# More workers use more memory.
# ALPINE_SOLVER_WORKERS=2

# Optional ignored runtime location for aggregate monthly counters only.
# ALPINE_PROVIDER_USAGE_DB=.local-data/runtime/provider-usage.sqlite
# ALPINE_ROUTE_JOBS_DB=.local-data/runtime/route-jobs.sqlite
# Maintained HTTPS release.json URL or a local developer release directory.
# Docker defaults to .local-data/releases/prepared mounted read-only.
# ALPINE_COVERAGE_CATALOG=https://example.com/coverage/release.json
# ALPINE_COVERAGE_ROOT=.local-data/coverage
