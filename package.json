{
  "name": "alpine-loop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node scripts/start.mjs",
    "dev": "npm start",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.server.json && vitest run && node --test tests/data/witness.test.mjs tests/data/install-data.test.mjs tests/data/build-cache.test.mjs",
    "verify": "npm run build && npm run typecheck && npm test",
    "size": "node scripts/source-size.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.5",
    "fastify": "5.12.5",
    "maplibre-gl": "6.13.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
